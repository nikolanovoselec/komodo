# Same pinned Python base as the existing collector, plus the offline MMDB reader.
FROM python:3.15-slim@sha256:044d5bd747976e21f8bc4d746c3479b19a84bb8ae6261b802acdd26b29036c93
RUN pip install --no-cache-dir maxminddb==3.2.0 \
    && mkdir -p /geoip /history \
    && chown 65534:65534 /geoip /history
WORKDIR /app
COPY *.py pve-root-ca.pem /app/
ENV PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
CMD ["python", "-B", "/app/adapter.py"]

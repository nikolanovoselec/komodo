[Unit]
Description=Hermes persistent Chromium browser
After=network-online.target hermes-browser-display.service
Requires=hermes-browser-display.service
Wants=network-online.target

[Service]
Type=simple
User=hermes-browser
Group=hermes-browser
Environment=HOME=/var/lib/hermes-browser
Environment=DISPLAY=:99
Environment=XDG_RUNTIME_DIR=/run/hermes-browser
RuntimeDirectory=hermes-browser
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/chromium \
  --user-data-dir=/var/lib/hermes-browser/profile \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --password-store=basic \
  --no-first-run \
  --no-default-browser-check \
  --disable-background-networking \
  --disable-component-update \
  --disable-sync \
  --disable-gpu \
  --window-position=0,0 \
  --window-size=1920,1080 \
  about:blank
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

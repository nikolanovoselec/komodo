[Unit]
Description=KasmVNC display for the Hermes persistent browser
After=network.target

[Service]
Type=simple
User=hermes-browser
Group=hermes-browser
Environment=HOME=/var/lib/hermes-browser
RuntimeDirectory=hermes-browser
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/Xkasmvnc :99 -geometry 1920x1080 -depth 24 -interface 0.0.0.0 -PublicIP 192.168.3.203 -disableBasicAuth -SecurityTypes None -httpd /usr/share/kasmvnc/www -websocketPort 6080 -sslOnly 0 -FreeKeyMappings -AlwaysShared -AcceptKeyEvents 1 -AcceptPointerEvents 1 -AcceptCutText 1 -SendCutText 1 -SendPrimary 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

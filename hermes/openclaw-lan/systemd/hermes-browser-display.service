[Unit]
Description=Private display for the Hermes persistent browser
After=network.target

[Service]
Type=simple
User=hermes-browser
Group=hermes-browser
Environment=HOME=/var/lib/hermes-browser
RuntimeDirectory=hermes-browser
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/Xtigervnc :99 -geometry 1920x1080 -depth 24 -localhost yes -rfbport 5900 -SecurityTypes VncAuth -PasswordFile /etc/hermes-browser/vnc.pass -AlwaysShared -AcceptKeyEvents -AcceptPointerEvents
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=Loopback-only noVNC for the Hermes persistent browser
After=network-online.target hermes-browser-display.service
Requires=hermes-browser-display.service
Wants=network-online.target

[Service]
Type=simple
User=hermes-browser
Group=hermes-browser
Environment=HOME=/var/lib/hermes-browser
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

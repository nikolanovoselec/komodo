# Runtime secrets belong in /root/.hermes/.env, sourced from the private
# nikolanovoselec/secrets repository. Do not put real values in this file.
HERMES_DASHBOARD_OIDC_ISSUER=https://idp.example.com/application/o/hermes/
HERMES_DASHBOARD_OIDC_CLIENT_ID=replace-me
HERMES_DASHBOARD_OIDC_CLIENT_SECRET=replace-me
HERMES_DASHBOARD_OIDC_SCOPES=openid profile email
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.example.com
HERMES_BROWSER_VNC_PASSWORD=replace-with-a-random-password

# Complete these after linking Signal and WhatsApp.
SIGNAL_HTTP_URL=http://127.0.0.1:8080
SIGNAL_ACCOUNT=+000000000000
SIGNAL_ALLOWED_USERS=+000000000000
SIGNAL_HOME_CHANNEL=+000000000000
WHATSAPP_ENABLED=false
WHATSAPP_MODE=self-chat
WHATSAPP_ALLOWED_USERS=000000000000

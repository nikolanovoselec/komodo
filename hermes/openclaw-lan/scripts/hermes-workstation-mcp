#!/usr/bin/env bash
set -euo pipefail

mode="${1:?usage: hermes-workstation-mcp codex|cua}"
ssh_args=(
  -T
  -i /root/.ssh/hermes-workstation
  -p 22022
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=accept-new
  -o ServerAliveInterval=30
  -o ServerAliveCountMax=3
  nikolanovoselec@127.0.0.1
)

case "$mode" in
  codex)
    exec ssh "${ssh_args[@]}" /usr/local/bin/hermes-codex-mcp
    ;;
  cua)
    exec ssh "${ssh_args[@]}" /usr/local/bin/hermes-cua-mcp
    ;;
  *)
    echo "unknown workstation MCP mode: $mode" >&2
    exit 64
    ;;
esac

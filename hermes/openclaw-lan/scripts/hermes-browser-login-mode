#!/usr/bin/env bash
set -euo pipefail

test "$(id -u)" -eq 0 || { echo "run as root" >&2; exit 1; }

case "${1:-}" in
  enter)
    systemctl stop hermes-gateway.service hermes-dashboard.service
    pkill -u root -f '^/root/.local/share/uv/tools/browser-use/bin/python -m browser_harness.daemon$' 2>/dev/null || true
    install -m 0600 /dev/null /run/hermes-browser-login-mode
    echo "Login mode active: agent services stopped; persistent browser and noVNC remain available."
    ;;
  exit)
    unlink /run/hermes-browser-login-mode 2>/dev/null || true
    systemctl start hermes-dashboard.service hermes-gateway.service
    echo "Login mode inactive: Hermes dashboard and gateway started."
    ;;
  status)
    if [[ -e /run/hermes-browser-login-mode ]]; then
      echo "active"
    else
      echo "inactive"
    fi
    ;;
  *)
    echo "usage: hermes-browser-login-mode {enter|exit|status}" >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

test "$#" -ge 1 || {
  echo "usage: hermes-network-ssh user@host [command ...]" >&2
  exit 64
}

target="$1"
shift

export HOME=/home/nikolanovoselec
export SSH_AUTH_SOCK=/home/nikolanovoselec/.1password/agent.sock

test -S "$SSH_AUTH_SOCK" || {
  echo "1Password SSH agent is unavailable at $SSH_AUTH_SOCK" >&2
  exit 69
}

exec /usr/bin/ssh \
  -4 \
  -o BatchMode=yes \
  -o PasswordAuthentication=no \
  -o KbdInteractiveAuthentication=no \
  -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=15 \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ControlMaster=auto \
  -o ControlPersist=10m \
  -o ControlPath=/tmp/hermes-network-ssh-%C \
  "$target" "$@"

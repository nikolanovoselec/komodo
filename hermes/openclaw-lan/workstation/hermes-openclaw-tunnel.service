[Unit]
Description=Reverse SSH tunnel for Hermes workstation bridge
After=network-online.target sshd.service
Wants=network-online.target

[Service]
Type=simple
User=nikolanovoselec
Environment=HOME=/home/nikolanovoselec
ExecStart=/usr/bin/ssh -NT -i /home/nikolanovoselec/.ssh/hermes-openclaw-tunnel -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:22022:127.0.0.1:22 root@openclaw.lan
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
